# Same Supabase connection strings as packages/db/.env.example
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Optional: enables email notifications on new enquiries
RESEND_API_KEY=""
ENQUIRY_NOTIFICATION_EMAIL=""

# Shared with apps/admin — lets the admin app trigger instant cache refresh on publish
REVALIDATE_SECRET=""
