# Same Supabase connection strings as packages/db/.env.example
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Generate with: npx auth secret
AUTH_SECRET=""

# Optional: emails a temporary password when a Super Admin adds a team member
RESEND_API_KEY=""

# Same value as apps/web's REVALIDATE_SECRET, plus the public site's URL
REVALIDATE_SECRET=""
WEB_APP_URL="http://localhost:3000"

# Optional: enables the "Upload" button next to image URL fields in the admin.
# Without these, the fields still work as plain URL inputs — the upload button
# just doesn't render. To set up: create a free account at cloudinary.com, copy
# the "Cloud name" from your dashboard, then go to Settings > Upload > Upload
# presets > Add upload preset, set Signing Mode to "Unsigned", and use its name here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
