{
  "name": "damc",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @damc/db run generate",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @damc/db generate",
    "db:push": "pnpm --filter @damc/db push",
    "db:seed": "pnpm --filter @damc/db seed",
    "db:backfill-executives": "pnpm --filter @damc/db backfill-executive-categories",
    "db:studio": "pnpm --filter @damc/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  }
}
